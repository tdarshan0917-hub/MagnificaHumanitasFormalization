theorem MagnificaHumanitas.stronger_compliance_iff : ∀ {P A D : Type} (g : MagnificaHumanitas.Governance P A D) (d : D),
  MagnificaHumanitas.CompliantAt g (MagnificaHumanitas.harmRemedyPolicy g) d ↔
