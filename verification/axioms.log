                h (fun h_2 => False.elim (noConfusion_of_Nat Bool.ctorIdx h_2)) (Eq.refl true) (HEq.refl h))
            (Eq.symm h_1) h)
        (fun h_1 =>
          Eq.ndrec (motive := fun bindingLocal =>
            bindingLocal = true →
