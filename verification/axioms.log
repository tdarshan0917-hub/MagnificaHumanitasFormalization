            (∀ (outcome : Bool),
                ∃ proposal,
                  (MagnificaHumanitas.Participation.process bindingLocal).accepts d proposal ∧
                    ∀ (override : Option Bool),
                      (MagnificaHumanitas.Participation.process bindingLocal).decide d
                          ((MagnificaHumanitas.Participation.process bindingLocal).record d proposal) override =
                        outcome) →
              bindingLocal = true)
