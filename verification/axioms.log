theorem MagnificaHumanitas.HighStakes.timely_stop_protects_all_continuations : ∀
  (s : MagnificaHumanitas.HighStakes.State) (events : List MagnificaHumanitas.HighStakes.Event),
  s.loss = false →
    s.stopDelivered = true →
      (MagnificaHumanitas.HighStakes.run s events).loss = false ∧
        (MagnificaHumanitas.HighStakes.run s events).stopDelivered = true :=
fun s events hLoss hStop =>
  List.rec (motive := fun events =>
    ∀ (s : MagnificaHumanitas.HighStakes.State),
      s.loss = false →
        s.stopDelivered = true →
          (MagnificaHumanitas.HighStakes.run s events).loss = false ∧
            (MagnificaHumanitas.HighStakes.run s events).stopDelivered = true)
    (fun s hLoss hStop => ⟨hLoss, hStop⟩)
    (fun e es ih s hLoss hStop =>
      have hp := MagnificaHumanitas.HighStakes.protected_step s e hLoss hStop;
      ih (MagnificaHumanitas.HighStakes.step s e) hp.left hp.right)
    events s hLoss hStop
