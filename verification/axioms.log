theorem MagnificaHumanitas.equal_scores_and_common_cutoff_give_equal_results : ∀ {P : Type} (score : P → Nat)
  (result : P → Bool) (cutoff : Nat),
  (∀ (p : P), result p = decide (cutoff ≤ score p)) →
    (∀ (p q : P), score p = score q) → ∀ (p q : P), result p = result q :=
fun {P} score result cutoff hRule hScores p q =>
  Eq.mpr (id (congrArg (fun _a => _a = result q) (hRule p)))
    (Eq.mpr (id (congrArg (fun _a => decide (cutoff ≤ score p) = _a) (hRule q)))
      (Eq.mpr (id (congrArg (fun _a => decide (cutoff ≤ _a) = decide (cutoff ≤ score q)) (hScores p q)))
        (Eq.refl (decide (cutoff ≤ score q)))))
