theorem MagnificaHumanitas.exclusion_without_appeal_fails_both : ∀ {P A D : Type}
  (g : MagnificaHumanitas.Governance P A D) (d : D) (p : P),
  g.excluded p d →
    ¬g.appeal p d →
      ¬MagnificaHumanitas.CompliantAt g (MagnificaHumanitas.responsibilityAppealPolicy g) d ∧
        ¬MagnificaHumanitas.CompliantAt g (MagnificaHumanitas.broadAppealPolicy g) d :=
fun {P A D} g d p hExcluded hNoAppeal =>
  ⟨fun h => hNoAppeal (h (MagnificaHumanitas.Safeguard.appeal p) hExcluded), fun h =>
    hNoAppeal (h (MagnificaHumanitas.Safeguard.appeal p) (Or.inl hExcluded))⟩
theorem MagnificaHumanitas.broad_compliance_iff_narrow_and_affected_appeal : ∀ {P A D : Type}
  (g : MagnificaHumanitas.Governance P A D) (d : D),
  MagnificaHumanitas.CompliantAt g (MagnificaHumanitas.broadAppealPolicy g) d ↔
    MagnificaHumanitas.CompliantAt g (MagnificaHumanitas.responsibilityAppealPolicy g) d ∧
      ∀ (p : P), g.highImpact d → g.affected p d → g.appeal p d :=
fun {P A D} g d =>
  {
    mp := fun h =>
      ⟨MagnificaHumanitas.broad_appeal_implies_narrow g d h, fun p hi ha =>
        h (MagnificaHumanitas.Safeguard.appeal p) (Or.inr ⟨hi, ha⟩)⟩,
    mpr := fun h r hr =>
      MagnificaHumanitas.Safeguard.casesOn (motive := fun t => r = t → MagnificaHumanitas.Provided g d r) r
        (fun h_1 =>
          Eq.ndrec (motive := fun r =>
            (MagnificaHumanitas.broadAppealPolicy g).required d r → MagnificaHumanitas.Provided g d r)
            (fun hr => h.left MagnificaHumanitas.Safeguard.identifiableResponsibility hr) (Eq.symm h_1) hr)
        (fun p h_1 =>
          Eq.ndrec (motive := fun r =>
            (MagnificaHumanitas.broadAppealPolicy g).required d r → MagnificaHumanitas.Provided g d r)
            (fun hr =>
              Or.casesOn (motive := fun t =>
                hr = t → MagnificaHumanitas.Provided g d (MagnificaHumanitas.Safeguard.appeal p)) hr
                (fun he h_2 => h.left (MagnificaHumanitas.Safeguard.appeal p) he)
                (fun hi h_2 => h.right p hi.left hi.right) (Eq.refl hr))
            (Eq.symm h_1) hr)
        (fun p h =>
          Eq.ndrec (motive := fun r =>
            (MagnificaHumanitas.broadAppealPolicy g).required d r → MagnificaHumanitas.Provided g d r)
            (fun hr => False.elim hr) (Eq.symm h) hr)
        (Eq.refl r) }
