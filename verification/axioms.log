theorem MagnificaHumanitas.final_control_from_reachability_and_binding : ∀ {D : Type}
  (p : MagnificaHumanitas.ConsultationProcess D) (d : D),
  (∀ (outcome : Bool), ∃ proposal, p.accepts d proposal ∧ p.record d proposal = outcome) →
    (∀ (proposal : Bool),
        p.accepts d proposal →
          ∀ (override : Option Bool), p.decide d (p.record d proposal) override = p.record d proposal) →
      ∀ (outcome : Bool),
        ∃ proposal,
          p.accepts d proposal ∧ ∀ (override : Option Bool), p.decide d (p.record d proposal) override = outcome :=
fun {D} p d hReachable hBinding outcome =>
  Exists.casesOn (hReachable outcome) fun proposal h =>
    And.casesOn h fun ha hr => Exists.intro proposal ⟨ha, fun override => Eq.trans (hBinding proposal ha override) hr⟩
